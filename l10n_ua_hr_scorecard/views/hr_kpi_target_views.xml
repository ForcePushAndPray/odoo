<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="hr_kpi_target_view_form" model="ir.ui.view">
        <field name="name">hr.kpi.target.form</field>
        <field name="model">hr.kpi.target</field>
        <field name="arch" type="xml">
            <form string="KPI Target">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_draft" string="Reset to Draft" type="object"
                            invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="kpi_id" readonly="state == 'confirmed'"/>
                            <field name="period_id" readonly="state == 'confirmed'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="calculation_method"/>
                            <field name="higher_is_better"/>
                            <field name="uom_name"/>
                        </group>
                    </group>
                    <group>
                        <group string="Values">
                            <field name="planned_value"
                                   readonly="state == 'confirmed' or calculation_method == 'binary'"/>
                            <field name="actual_value"
                                   readonly="state == 'confirmed' or calculation_method == 'binary'"/>
                            <field name="binary_achieved"
                                   readonly="state == 'confirmed' or calculation_method != 'binary'"/>
                        </group>
                        <group string="Result">
                            <field name="achievement"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_kpi_target_view_list" model="ir.ui.view">
        <field name="name">hr.kpi.target.list</field>
        <field name="model">hr.kpi.target</field>
        <field name="arch" type="xml">
            <list string="KPI Targets"
                  decoration-success="state == 'confirmed'"
                  decoration-info="state == 'draft'">
                <field name="kpi_id"/>
                <field name="period_id"/>
                <field name="calculation_method"/>
                <field name="planned_value"/>
                <field name="actual_value"/>
                <field name="binary_achieved" optional="hide"/>
                <field name="achievement"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'confirmed'"
                       decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="hr_kpi_target_view_search" model="ir.ui.view">
        <field name="name">hr.kpi.target.search</field>
        <field name="model">hr.kpi.target</field>
        <field name="arch" type="xml">
            <search string="KPI Targets">
                <field name="kpi_id"/>
                <field name="period_id"/>
                <separator/>
                <filter string="Draft" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="filter_confirmed"
                        domain="[('state', '=', 'confirmed')]"/>
                <separator/>
                <filter string="Period" name="group_period"
                        context="{'group_by': 'period_id'}"/>
                <filter string="KPI" name="group_kpi"
                        context="{'group_by': 'kpi_id'}"/>
                <filter string="Status" name="group_state"
                        context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <!-- Master-detail view of periods with targets inline -->
    <record id="hr_kpi_period_targets_form" model="ir.ui.view">
        <field name="name">hr.kpi.period.targets.form</field>
        <field name="model">hr.kpi.period</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <form string="KPI Targets">
                <header>
                    <button name="action_close" string="Close Period" type="object"
                            class="btn-primary" invisible="state != 'open'"/>
                    <button name="action_reopen" string="Reopen" type="object"
                            invisible="state != 'closed'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="open,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="period_type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <separator string="KPI Targets"/>
                    <field name="target_ids" context="{'default_period_id': id}">
                        <list editable="bottom"
                              decoration-success="state == 'confirmed'"
                              decoration-info="state == 'draft'">
                            <field name="kpi_id"
                                   readonly="state == 'confirmed'"/>
                            <field name="calculation_method"/>
                            <field name="uom_name" optional="show"/>
                            <field name="planned_value"
                                   readonly="state == 'confirmed' or calculation_method == 'binary'"/>
                            <field name="actual_value"
                                   readonly="state == 'confirmed' or calculation_method == 'binary'"/>
                            <field name="binary_achieved"
                                   readonly="state == 'confirmed' or calculation_method != 'binary'"/>
                            <field name="achievement"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'confirmed'"
                                   decoration-info="state == 'draft'"/>
                            <button name="action_confirm" string="Confirm" type="object"
                                    icon="fa-check" invisible="state == 'confirmed'"
                                    groups="l10n_ua_hr_base.group_hr_ua_officer"/>
                            <button name="action_draft" string="Reset" type="object"
                                    icon="fa-undo" invisible="state == 'draft'"
                                    groups="l10n_ua_hr_base.group_hr_ua_officer"/>
                            <button name="action_open_employees" string="Employees" type="object"
                                    icon="fa-users"
                                    groups="l10n_ua_hr_base.group_hr_ua_officer"/>
                            <button name="action_assign_to_employee" string="Assign" type="object"
                                    icon="fa-user-plus"
                                    groups="l10n_ua_hr_base.group_hr_ua_officer"/>
                            <button name="action_open_kpi" string="Settings" type="object"
                                    icon="fa-cog"
                                    groups="l10n_ua_hr_base.group_hr_ua_officer"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_kpi_targets" model="ir.actions.act_window">
        <field name="name">KPI Targets</field>
        <field name="res_model">hr.kpi.period</field>
        <field name="view_mode">list,form</field>
        <field name="views"
               eval="[(ref('hr_kpi_period_view_list'), 'list'),
                      (ref('hr_kpi_period_targets_form'), 'form')]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set planned and actual values for KPIs by period</p>
            <p>Pick a period on the left, then maintain planned/actual values for each KPI on the right.</p>
        </field>
    </record>

</odoo>
