<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="hr_kpi_target_view_form" model="ir.ui.view">
        <field name="name">hr.kpi.target.form</field>
        <field name="model">hr.kpi.target</field>
        <field name="arch" type="xml">
            <form string="KPI Target">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_draft" string="Reset to Draft" type="object"
                            invisible="state != 'confirmed'"/>
                    <button name="action_open_assignments" string="Assignments" type="object"
                            class="btn-secondary"
                            groups="l10n_ua_hr_base.group_hr_ua_officer"/>
                    <button name="action_open_kpi" string="KPI Settings" type="object"
                            class="btn-secondary"
                            groups="l10n_ua_hr_base.group_hr_ua_officer"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="kpi_id" readonly="state == 'confirmed'"/>
                            <field name="period_id" readonly="state == 'confirmed'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="calculation_method"/>
                            <field name="higher_is_better"/>
                            <field name="uom_name"/>
                        </group>
                    </group>
                    <group>
                        <group string="Values">
                            <field name="planned_value"
                                   readonly="state == 'confirmed' or calculation_method == 'binary'"/>
                            <field name="actual_value"
                                   readonly="state == 'confirmed' or calculation_method == 'binary'"/>
                            <field name="binary_achieved"
                                   readonly="state == 'confirmed' or calculation_method != 'binary'"/>
                        </group>
                        <group string="Result">
                            <field name="achievement"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_kpi_target_view_list" model="ir.ui.view">
        <field name="name">hr.kpi.target.list</field>
        <field name="model">hr.kpi.target</field>
        <field name="arch" type="xml">
            <list string="KPI Targets"
                  editable="bottom"
                  decoration-success="state == 'confirmed'"
                  decoration-info="state == 'draft'">
                <control>
                    <create string="New"/>
                    <button name="%(action_hr_kpi_bulk_assign)d" type="action"
                            string="Assign" class="btn-secondary"
                            groups="l10n_ua_hr_base.group_hr_ua_officer"/>
                </control>
                <field name="period_id" readonly="state == 'confirmed'"/>
                <field name="kpi_id" readonly="state == 'confirmed'"/>		
                <field name="calculation_method" column_invisible="1"/>
                <field name="uom_name" optional="show"/>
                <field name="planned_value"
                       readonly="state == 'confirmed' or calculation_method == 'binary'"/>
                <field name="actual_value"
                       readonly="state == 'confirmed' or calculation_method == 'binary'"/>
                <field name="binary_achieved"
                       readonly="state == 'confirmed' or calculation_method != 'binary'"/>
                <field name="achievement"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'confirmed'"
                       decoration-info="state == 'draft'"/>
                <button name="action_confirm" string="Confirm" type="object"
                        icon="fa-check" invisible="state == 'confirmed'"
                        groups="l10n_ua_hr_base.group_hr_ua_officer"/>
                <button name="action_draft" string="Reset" type="object"
                        icon="fa-undo" invisible="state == 'draft'"
                        groups="l10n_ua_hr_base.group_hr_ua_officer"/>
                <button name="action_open_assignments" string="Assignments" type="object"
                        icon="fa-users"
                        groups="l10n_ua_hr_base.group_hr_ua_officer"/>
                <button name="action_open_kpi" string="Settings" type="object"
                        icon="fa-cog"
                        groups="l10n_ua_hr_base.group_hr_ua_officer"/>
            </list>
        </field>
    </record>

    <record id="hr_kpi_target_view_kanban" model="ir.ui.view">
        <field name="name">hr.kpi.target.kanban</field>
        <field name="model">hr.kpi.target</field>
        <field name="arch" type="xml">
            <kanban default_group_by="kpi_id" class="o_kanban_small_column">
                <field name="kpi_id"/>
                <field name="period_id"/>
                <field name="planned_value"/>
                <field name="actual_value"/>
                <field name="achievement"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <strong><field name="kpi_id"/></strong>
                                <field name="state" widget="badge"
                                       decoration-success="state == 'confirmed'"
                                       decoration-info="state == 'draft'"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>Planned: <field name="planned_value"/></div>
                                <div>Actual: <field name="actual_value"/></div>
                                <div>Achievement: <field name="achievement"/>%</div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="hr_kpi_target_view_search" model="ir.ui.view">
        <field name="name">hr.kpi.target.search</field>
        <field name="model">hr.kpi.target</field>
        <field name="arch" type="xml">
            <search string="KPI Targets">
                <field name="kpi_id"/>
                <field name="period_id"/>
                <separator/>
                <filter string="Draft" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="filter_confirmed"
                        domain="[('state', '=', 'confirmed')]"/>
                <separator/>
                <filter string="Period" name="group_period"
                        context="{'group_by': 'period_id'}"/>
                <filter string="KPI" name="group_kpi"
                        context="{'group_by': 'kpi_id'}"/>
                <filter string="Status" name="group_state"
                        context="{'group_by': 'state'}"/>
                <searchpanel>
                    <field name="period_id" string="Periods" enable_counters="1"
                           expand="1" icon="fa-calendar"/>
                    <field name="state" string="Status" enable_counters="1"
                           icon="fa-tasks" select="multi"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_hr_kpi_targets" model="ir.actions.act_window">
        <field name="name">KPI Targets</field>
        <field name="res_model">hr.kpi.target</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="hr_kpi_target_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set planned and actual values for KPIs by period</p>
            <p>Pick a period on the left sidebar, then maintain planned/actual values for each KPI on the right.</p>
        </field>
    </record>

</odoo>
