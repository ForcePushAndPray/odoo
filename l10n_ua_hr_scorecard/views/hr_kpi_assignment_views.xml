<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="hr_kpi_assignment_view_form" model="ir.ui.view">
        <field name="name">hr.kpi.assignment.form</field>
        <field name="model">hr.kpi.assignment</field>
        <field name="arch" type="xml">
            <form string="KPI Assignment">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_kpis" type="object" class="oe_stat_button"
                                icon="fa-bullseye" invisible="not id">
                            <field name="kpi_count" widget="statinfo" string="KPI"/>
                        </button>
                        <button name="action_open_targets" type="object" class="oe_stat_button"
                                icon="fa-crosshairs" invisible="not id">
                            <field name="target_count" widget="statinfo" string="Targets"/>
                        </button>
                        <button name="action_open_employees" type="object" class="oe_stat_button"
                                icon="fa-users" invisible="not id">
                            <field name="employee_count" widget="statinfo" string="Employees"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="job_id" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to" invisible="not date_to"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="company_id" column_invisible="1"/>
                            <field name="kpi_id" options="{'no_create': True}"
                                   domain="[('state', '=', 'confirmed'), ('company_id', 'in', [company_id, False])]"/>
                            <field name="weight" sum="Total weight"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field name="total_weight"
                               decoration-danger="total_weight &gt; 100"
                               decoration-warning="total_weight &lt; 100"
                               decoration-success="total_weight == 100"/>
                    </group>
                    <div class="text-muted small">
                        The total weight of the KPIs of a job position must not exceed 100%.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_kpi_assignment_view_list" model="ir.ui.view">
        <field name="name">hr.kpi.assignment.list</field>
        <field name="model">hr.kpi.assignment</field>
        <field name="arch" type="xml">
            <list string="KPI Assignment"
                  decoration-muted="kpi_count == 0"
                  decoration-warning="kpi_count != 0 and total_weight != 100">
                <field name="job_id"/>
                <field name="department_id" optional="show"/>
                <field name="date_from"/>
                <field name="kpi_count"/>
                <field name="total_weight"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="hr_kpi_assignment_view_search" model="ir.ui.view">
        <field name="name">hr.kpi.assignment.search</field>
        <field name="model">hr.kpi.assignment</field>
        <field name="arch" type="xml">
            <search string="KPI Assignment">
                <field name="job_id"/>
                <field name="department_id"/>
                <field name="line_ids" string="KPI" filter_domain="[('line_ids.kpi_id', 'ilike', self)]"/>
                <separator/>
                <filter string="Without KPIs" name="filter_without_kpis" domain="[('kpi_count', '=', 0)]"/>
                <filter string="Weight Not 100%" name="filter_weight_not_100"
                        domain="[('kpi_count', '!=', 0), ('total_weight', '!=', 100)]"/>
                <separator/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Department" name="group_department" context="{'group_by': 'department_id'}"/>
                <filter string="Valid From" name="group_date_from" context="{'group_by': 'date_from:year'}"/>
            </search>
        </field>
    </record>

    <record id="action_hr_kpi_assignment" model="ir.actions.act_window">
        <field name="name">KPI Assignment</field>
        <field name="res_model">hr.kpi.assignment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hr_kpi_assignment_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Assign KPIs to job positions</p>
            <p>Pick a job position, add its KPIs and their weights.</p>
        </field>
    </record>

</odoo>
