<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="hr_scorecard_view_form" model="ir.ui.view">
        <field name="name">hr.scorecard.form</field>
        <field name="model">hr.scorecard</field>
        <field name="arch" type="xml">
            <form string="Scorecard">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_close" string="Close" type="object"
                            class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_draft" string="Reset to Draft" type="object"
                            invisible="state == 'draft'"/>
                    <button name="action_accrue_bonus" string="Accrue Bonus" type="object"
                            class="btn-primary"
                            invisible="state == 'draft' or (bonus_model == 'period' and state != 'closed') or (bonus_model == 'monthly_advance' and advances_accrued and final_accrued) or (bonus_model == 'period' and final_accrued)"
                            groups="l10n_ua_hr_base.group_hr_ua_officer"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_bonuses" type="object"
                                class="oe_stat_button" icon="fa-money"
                                invisible="bonus_count == 0">
                            <field name="bonus_count" widget="statinfo" string="Bonuses"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="department_id"/>
                            <field name="period_id" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="bonus_model" readonly="state != 'draft'"/>
                            <field name="bonus_type_id" readonly="advances_accrued or final_accrued"/>
                            <field name="bonus_base" readonly="state == 'closed' or advances_accrued"/>
                            <field name="advances_accrued"
                                   invisible="bonus_model != 'monthly_advance'"/>
                            <field name="final_accrued"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="KPI Lines" name="lines">
                            <field name="line_ids" readonly="state == 'closed'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="kpi_id"/>
                                    <field name="calculation_method"/>
                                    <field name="weight" sum="Total weight"/>
                                    <field name="planned_value"
                                           readonly="calculation_method == 'binary'"/>
                                    <field name="actual_value"
                                           readonly="calculation_method == 'binary'"/>
                                    <field name="binary_achieved"
                                           readonly="calculation_method != 'binary'"/>
                                    <field name="uom_name" optional="hide"/>
                                    <field name="achievement"/>
                                    <field name="weighted_achievement" sum="Weighted result"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_weight"/>
                                <field name="weighted_result"/>
                                <field name="bonus_amount"/>
                            </group>
                        </page>
                        <page string="Accrued Bonuses" name="bonuses">
                            <field name="bonus_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="bonus_type_id"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'paid'"
                                           decoration-info="state == 'draft'"
                                           decoration-warning="state == 'confirmed'"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hr_scorecard_view_list" model="ir.ui.view">
        <field name="name">hr.scorecard.list</field>
        <field name="model">hr.scorecard</field>
        <field name="arch" type="xml">
            <list string="Scorecards" decoration-muted="state == 'closed'"
                  decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id" optional="show"/>
                <field name="period_id"/>
                <field name="weighted_result"/>
                <field name="bonus_amount" sum="Total"/>
                <field name="bonus_count" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'closed'"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'confirmed'"/>
            </list>
        </field>
    </record>

    <record id="hr_scorecard_view_search" model="ir.ui.view">
        <field name="name">hr.scorecard.search</field>
        <field name="model">hr.scorecard</field>
        <field name="arch" type="xml">
            <search string="Scorecards">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="period_id"/>
                <separator/>
                <filter string="Draft" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="filter_confirmed"
                        domain="[('state', '=', 'confirmed')]"/>
                <filter string="Closed" name="filter_closed"
                        domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter string="Bonus Accrued" name="filter_final_accrued"
                        domain="[('final_accrued', '=', True)]"/>
                <filter string="Pending Accrual" name="filter_not_accrued"
                        domain="[('final_accrued', '=', False), ('state', 'in', ('confirmed', 'closed'))]"/>
                <separator/>
                <filter string="Employee" name="group_employee"
                        context="{'group_by': 'employee_id'}"/>
                <filter string="Period" name="group_period"
                        context="{'group_by': 'period_id'}"/>
                <filter string="Department" name="group_department"
                        context="{'group_by': 'department_id'}"/>
                <filter string="Status" name="group_state"
                        context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_hr_scorecard" model="ir.actions.act_window">
        <field name="name">Scorecards</field>
        <field name="res_model">hr.scorecard</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hr_scorecard_view_search"/>
    </record>

</odoo>
