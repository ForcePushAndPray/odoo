<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="hr_scorecard_view_form" model="ir.ui.view">
        <field name="name">hr.scorecard.form</field>
        <field name="model">hr.scorecard</field>
        <field name="arch" type="xml">
            <form string="Scorecard">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_close" string="Close" type="object"
                            class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_draft" string="Reset to Draft" type="object"
                            invisible="state == 'draft'"/>
                    <button name="action_accrue_bonus" string="Accrue Bonuses" type="object"
                            class="btn-primary"
                            invisible="state == 'draft'"
                            groups="l10n_ua_hr_base.group_hr_ua_officer"
                            help="Create hr.bonus records for the employees of the job position. Already accrued bonuses are not duplicated."/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_employees" type="object"
                                class="oe_stat_button" icon="fa-users">
                            <field name="employee_count" widget="statinfo" string="Employees"/>
                        </button>
                        <button name="action_open_bonuses" type="object"
                                class="oe_stat_button" icon="fa-money"
                                invisible="bonus_count == 0">
                            <field name="bonus_count" widget="statinfo" string="Bonuses"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="job_id" readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="department_id"/>
                            <field name="period_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="company_id"
                                   options="{'no_create': True, 'no_open': True}"
                                   groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="KPI Lines" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="kpi_id"/>
                                    <field name="calculation_method"/>
                                    <field name="weight" sum="Total weight"/>
                                    <field name="planned_value"/>
                                    <field name="actual_value"/>
                                    <field name="binary_achieved" optional="hide"/>
                                    <field name="uom_name" optional="hide"/>
                                    <field name="achievement"/>
                                    <field name="weighted_achievement" sum="Weighted result"/>
                                    <field name="target_state" optional="show"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_weight"/>
                                <field name="weighted_result"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hr_scorecard_employee_result_view_list" model="ir.ui.view">
        <field name="name">hr.scorecard.employee.result.list</field>
        <field name="model">hr.scorecard.employee.result</field>
        <field name="arch" type="xml">
            <list string="Employees" create="0" edit="0" delete="0"
                  decoration-muted="not bonus_model">
                <field name="employee_id"/>
                <field name="job_id" optional="hide"/>
                <field name="period_id" optional="hide"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="days_in_position"/>
                <field name="period_days" optional="hide"/>
                <field name="bonus_model"/>
                <field name="bonus_type_id" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="planned_bonus" sum="Total planned bonus"/>
                <field name="bonus_base" sum="Total prorated bonus base"/>
                <field name="weighted_result"/>
                <field name="bonus_amount" sum="Total bonus"/>
                <field name="accrued_amount" sum="Total accrued"/>
            </list>
        </field>
    </record>

</odoo>
