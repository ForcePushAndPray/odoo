<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="hr_kpi_period_view_form" model="ir.ui.view">
        <field name="name">hr.kpi.period.form</field>
        <field name="model">hr.kpi.period</field>
        <field name="arch" type="xml">
            <form string="KPI Period">
                <header>
                    <button name="action_close" string="Close Period" type="object"
                            class="btn-primary" invisible="state != 'open'"/>
                    <button name="action_reopen" string="Reopen" type="object"
                            invisible="state != 'closed'"/>
                    <button name="action_accrue_bonuses" string="Accrue Bonuses" type="object"
                            groups="l10n_ua_hr_base.group_hr_ua_officer"
                            help="Create hr.bonus records for every confirmed/closed scorecard in this period."/>
                    <field name="state" widget="statusbar" statusbar_visible="open,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Q1 2026"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="period_type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_kpi_period_view_list" model="ir.ui.view">
        <field name="name">hr.kpi.period.list</field>
        <field name="model">hr.kpi.period</field>
        <field name="arch" type="xml">
            <list string="KPI Periods" decoration-muted="state == 'closed'">
                <field name="name"/>
                <field name="period_type"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'open'"
                       decoration-muted="state == 'closed'"/>
            </list>
        </field>
    </record>

    <record id="action_hr_kpi_period" model="ir.actions.act_window">
        <field name="name">KPI Periods</field>
        <field name="res_model">hr.kpi.period</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
