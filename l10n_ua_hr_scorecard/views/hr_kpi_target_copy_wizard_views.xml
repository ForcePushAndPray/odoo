<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="hr_kpi_target_copy_wizard_view_form" model="ir.ui.view">
        <field name="name">hr.kpi.target.copy.wizard.form</field>
        <field name="model">hr.kpi.target.copy.wizard</field>
        <field name="arch" type="xml">
            <form string="Copy KPI Targets to Another Period">
                <group>
                    <field name="target_ids" widget="many2many_tags" readonly="1"/>
                </group>
                <group>
                    <group string="Period">
                        <field name="period_type"/>
                        <field name="period_year"/>
                        <field name="period_quarter"
                               invisible="period_type != 'quarter'"
                               required="period_type == 'quarter'"/>
                        <field name="period_month"
                               invisible="period_type != 'month'"
                               required="period_type == 'month'"/>
                    </group>
                    <group>
                        <field name="copy_planned_value"/>
                    </group>
                </group>
                <div class="alert alert-info" role="status" invisible="not period_missing">
                    This KPI period does not exist yet. It will be generated automatically.
                </div>
                <div class="text-muted">
                    Actual values, source reports and statuses are not copied. A KPI that already
                    has a target for this period, or for an overlapping one, is skipped.
                </div>
                <footer>
                    <button name="action_copy" type="object" string="Copy" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_kpi_target_copy" model="ir.actions.act_window">
        <field name="name">Copy to Another Period</field>
        <field name="res_model">hr.kpi.target.copy.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
