<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="hr_kpi_assign_wizard_view_form" model="ir.ui.view">
        <field name="name">hr.kpi.assign.wizard.form</field>
        <field name="model">hr.kpi.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign KPI to Employees">
                <sheet>
                    <group>
                        <field name="kpi_id" readonly="1"/>
                        <field name="period_id" readonly="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group>
                        <field name="employee_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                        <field name="weight"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_assign" string="Assign" type="object"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
