<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="hr_kpi_view_form" model="ir.ui.view">
        <field name="name">hr.kpi.form</field>
        <field name="model">hr.kpi</field>
        <field name="arch" type="xml">
            <form string="KPI">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_draft" string="Reset to Draft" type="object"
                            invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_targets" type="object" class="oe_stat_button"
                                icon="fa-crosshairs" invisible="not id">
                            <field name="target_count" widget="statinfo" string="Targets"/>
                        </button>
                        <button name="action_open_jobs" type="object" class="oe_stat_button"
                                icon="fa-briefcase" invisible="not id">
                            <field name="job_count" widget="statinfo" string="Job Positions"/>
                        </button>
                        <button name="action_open_employees" type="object" class="oe_stat_button"
                                icon="fa-users" invisible="not id">
                            <field name="employee_count" widget="statinfo" string="Employees"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Sales Target" readonly="state == 'confirmed'"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="calculation_method" readonly="state == 'confirmed'"/>
                            <field name="higher_is_better" readonly="state == 'confirmed'"/>
                            <field name="data_source" widget="radio"
                                   options="{'horizontal': true}" readonly="state == 'confirmed'"/>
                            <field name="use_formula" invisible="data_source != 'system'" readonly="state == 'confirmed'"/>
                            <field name="system_field"
                                   invisible="data_source != 'system' or use_formula"
                                   required="data_source == 'system' and not use_formula"
                                   readonly="state == 'confirmed'"/>
                        </group>
                        <group>
                            <field name="uom_name" readonly="state == 'confirmed'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state == 'confirmed'"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Formula" invisible="not use_formula or data_source != 'system'">
                        <field name="variable_ids" nolabel="1" colspan="2"
                               context="{'default_kpi_id': id}" readonly="state == 'confirmed'">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="code"/>
                                <field name="name"/>
                                <field name="system_field"/>
                            </list>
                        </field>
                        <field name="formula" widget="kpi_formula" colspan="2"
                               placeholder="e.g. (A - B) / C * 100"
                               required="use_formula" readonly="state == 'confirmed'"/>
                        <div colspan="2" class="text-danger" invisible="not formula_error">
                            <field name="formula_error"/>
                        </div>
                        <div colspan="2" class="text-muted small">
                            Use the variable codes, numbers, + - * / and parentheses. The variables
                            are read from the reports selected on each KPI target; write constants
                            directly in the formula.
                        </div>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" colspan="2" readonly="state == 'confirmed'"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_kpi_view_list" model="ir.ui.view">
        <field name="name">hr.kpi.list</field>
        <field name="model">hr.kpi</field>
        <field name="arch" type="xml">
            <list string="KPIs">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="calculation_method"/>
                <field name="data_source" optional="show"/>
                <field name="uom_name" optional="show"/>
                <field name="higher_is_better" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'confirmed'"
                       decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="hr_kpi_view_search" model="ir.ui.view">
        <field name="name">hr.kpi.search</field>
        <field name="model">hr.kpi</field>
        <field name="arch" type="xml">
            <search string="KPIs">
                <field name="name"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="filter_confirmed" domain="[('state', '=', 'confirmed')]"/>
                <separator/>
                <filter string="Binary" name="filter_binary"
                        domain="[('calculation_method', '=', 'binary')]"/>
                <filter string="Coefficient" name="filter_coefficient"
                        domain="[('calculation_method', '=', 'coefficient')]"/>
                <separator/>
                <filter string="Archived" name="filter_archived"
                        domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Calculation Method" name="group_method"
                        context="{'group_by': 'calculation_method'}"/>
            </search>
        </field>
    </record>

    <record id="action_hr_kpi" model="ir.actions.act_window">
        <field name="name">KPIs</field>
        <field name="res_model">hr.kpi</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hr_kpi_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define a new KPI</p>
            <p>KPIs are reusable indicators with a planned target and a calculation method.</p>
        </field>
    </record>

</odoo>
