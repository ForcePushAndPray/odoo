<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="hr_kpi_view_form" model="ir.ui.view">
        <field name="name">hr.kpi.form</field>
        <field name="model">hr.kpi</field>
        <field name="arch" type="xml">
            <form string="KPI">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Sales Target"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="calculation_method"/>
                            <field name="higher_is_better"/>
                        </group>
                        <group>
                            <field name="uom_name"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_kpi_view_list" model="ir.ui.view">
        <field name="name">hr.kpi.list</field>
        <field name="model">hr.kpi</field>
        <field name="arch" type="xml">
            <list string="KPIs">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="calculation_method"/>
                <field name="uom_name" optional="show"/>
                <field name="higher_is_better" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="hr_kpi_view_search" model="ir.ui.view">
        <field name="name">hr.kpi.search</field>
        <field name="model">hr.kpi</field>
        <field name="arch" type="xml">
            <search string="KPIs">
                <field name="name"/>
                <field name="code"/>
                <filter string="Binary" name="filter_binary" domain="[('calculation_method', '=', 'binary')]"/>
                <filter string="Coefficient" name="filter_coef" domain="[('calculation_method', '=', 'coefficient')]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Calculation Method" name="group_method" context="{'group_by': 'calculation_method'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_kpi" model="ir.actions.act_window">
        <field name="name">KPIs</field>
        <field name="res_model">hr.kpi</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hr_kpi_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define a new KPI</p>
            <p>KPIs are reusable indicators with a planned target and a calculation method.</p>
        </field>
    </record>

</odoo>
