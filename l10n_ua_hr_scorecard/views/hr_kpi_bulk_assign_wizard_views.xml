<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="hr_kpi_bulk_assign_wizard_view_form" model="ir.ui.view">
        <field name="name">hr.kpi.bulk.assign.wizard.form</field>
        <field name="model">hr.kpi.bulk.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign KPIs by Position">
                <sheet>
                    <group>
                        <field name="company_id"
                               options="{'no_create': True, 'no_open': True}"
                               groups="base.group_multi_company"/>
                        <field name="period_id"
                               options="{'no_create': True, 'no_open': True}"
                               domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]"/>
                    </group>
                    <p class="text-muted">
                        For every employee in the selected company whose job position
                        matches a KPI's "Applies to Positions", the system will
                        get-or-create a scorecard in this period and add the missing
                        KPI lines. Existing assignments are kept untouched.
                    </p>
                </sheet>
                <footer>
                    <button name="action_run" string="Save" type="object"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_kpi_bulk_assign" model="ir.actions.act_window">
        <field name="name">Assign KPIs by Position</field>
        <field name="res_model">hr.kpi.bulk.assign.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
