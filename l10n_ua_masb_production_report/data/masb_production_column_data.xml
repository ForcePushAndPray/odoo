            <field name="block">debit</field>
            <field name="sequence">120</field>
            <field name="account_prefixes">65</field>
            <field name="cost_element">direct</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="column_debit_661" model="masb.production.column">
