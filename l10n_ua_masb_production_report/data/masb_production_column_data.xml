            <field name="account_prefixes">91</field>
            <field name="cost_element">overhead</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Credit block: accounts debited from production -->
        <record id="column_credit_23" model="masb.production.column">
            <field name="name">23 internal transfer</field>
            <field name="block">credit</field>
            <field name="sequence">10</field>
            <field name="account_prefixes">23</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="column_credit_26" model="masb.production.column">
            <field name="name">26 finished goods</field>
            <field name="block">credit</field>
            <field name="sequence">20</field>
            <field name="account_prefixes">26</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="column_credit_39" model="masb.production.column">
            <field name="name">39 deferred costs</field>
            <field name="block">credit</field>
            <field name="sequence">30</field>
            <field name="account_prefixes">39</field>
