<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="masb_production_report_view_form" model="ir.ui.view">
        <field name="name">masb.production.report.form</field>
        <field name="model">masb.production.report</field>
        <field name="arch" type="xml">
            <form string="Production Cost Statement">
                <header>
                    <button name="action_compute" type="object" string="Compute"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_export_xlsx" type="object"
                            string="Export XLSX" invisible="not line_ids"/>
                    <button name="action_open_pivot" type="object"
                            string="Pivot" invisible="not line_ids"/>
                    <button name="action_confirm" type="object" string="Confirm"
                            invisible="state != 'draft' or not line_ids"/>
                    <button name="action_draft" type="object"
                            string="Reset to Draft"
                            invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="not line_ids or is_balanced">
                        The statement does not match the journal items. Recompute
                        it; if the difference stays, an entry mixes several debit
                        and credit lines whose pairing cannot be restored.
                    </div>
                    <div class="alert alert-info" role="alert"
                         invisible="not unassigned_amount">
                        Part of the turnover carries no subdivision. Those
                        amounts are shown in the row without a subdivision.
                    </div>
                    <group>
                        <group name="period">
                            <field name="date_from"
                                   readonly="state == 'confirmed'"/>
                            <field name="date_to"
                                   readonly="state == 'confirmed'"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"
                                   readonly="state == 'confirmed'"/>
                        </group>
                        <group name="scope">
                            <field name="analytic_plan_id"
                                   readonly="state == 'confirmed'"/>
                            <field name="account_prefix"
                                   readonly="state == 'confirmed'"/>
                            <field name="show_all_columns"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Control" invisible="not line_ids">
                        <group>
                            <field name="total_debit"/>
                            <field name="control_debit"/>
                            <field name="unassigned_amount"/>
                        </group>
                        <group>
                            <field name="total_credit"/>
                            <field name="control_credit"/>
                            <field name="is_balanced"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Statement" name="matrix">
                            <widget name="masb_production_matrix"/>
                        </page>
                        <page string="Lines" name="lines">
                            <field name="line_ids" readonly="1">
                                <list string="Lines"
                                      decoration-bf="line_type == 'group'"
                                      default_order="sequence">
                                    <field name="sequence" column_invisible="1"/>
                                    <field name="line_type"
                                           column_invisible="1"/>
                                    <field name="account_id"/>
                                    <field name="analytic_account_id"/>
                                    <field name="cost_element"/>
                                    <field name="opening_balance"/>
                                    <field name="turnover_debit"
                                           sum="Total debit"/>
                                    <field name="turnover_credit"
                                           sum="Total credit"/>
                                    <field name="closing_balance"/>
                                    <field name="currency_id"
                                           column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="masb_production_report_view_list" model="ir.ui.view">
        <field name="name">masb.production.report.list</field>
        <field name="model">masb.production.report</field>
        <field name="arch" type="xml">
            <list string="Production Cost Statements">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="account_prefix"/>
                <field name="total_debit" sum="Total debit"/>
                <field name="total_credit" sum="Total credit"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'confirmed'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="masb_production_report_action" model="ir.actions.act_window">
        <field name="name">Production Cost Statement</field>
        <field name="res_model">masb.production.report</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Build the statement of account 23
            </p>
            <p>
                Set the period and press Compute. Costs are grouped by
                production sub-account, subdivision and cost element.
            </p>
        </field>
    </record>

    <record id="masb_production_report_line_view_list" model="ir.ui.view">
        <field name="name">masb.production.report.line.list</field>
        <field name="model">masb.production.report.line</field>
        <field name="arch" type="xml">
            <list string="Statement Lines" create="false">
                <field name="report_id"/>
                <field name="account_id"/>
                <field name="analytic_account_id"/>
                <field name="cost_element"/>
                <field name="opening_balance"/>
                <field name="turnover_debit" sum="Total debit"/>
                <field name="turnover_credit" sum="Total credit"/>
                <field name="closing_balance"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

</odoo>
