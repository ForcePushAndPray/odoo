<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="masb_account_turnover_view_form" model="ir.ui.view">
        <field name="name">masb.account.turnover.form</field>
        <field name="model">masb.account.turnover</field>
        <field name="arch" type="xml">
            <form string="Journal-Order and Ledger">
                <header>
                    <button name="action_compute" type="object" string="Compute"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_export_xlsx" type="object"
                            string="Export XLSX" invisible="not line_ids"/>
                    <button name="action_open_pivot" type="object"
                            string="Pivot" invisible="not line_ids"/>
                    <button name="action_confirm" type="object" string="Confirm"
                            invisible="state != 'draft' or not line_ids"/>
                    <button name="action_draft" type="object"
                            string="Reset to Draft"
                            invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="not line_ids or is_balanced">
                        The statement does not match the journal items. Recompute
                        it; if the difference stays, an entry mixes several debit
                        and credit lines whose pairing cannot be restored.
                    </div>
                    <div class="alert alert-info" role="alert"
                         invisible="not unassigned_amount">
                        Part of the turnover carries no analytics. Those amounts
                        are shown in a row of their own at the end of the
                        statement.
                    </div>
                    <group>
                        <group name="period">
                            <field name="type_id"
                                   readonly="state == 'confirmed' or line_ids"
                                   options="{'no_create': True}"/>
                            <field name="date_from"
                                   readonly="state == 'confirmed'"/>
                            <field name="date_to"
                                   readonly="state == 'confirmed'"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"
                                   readonly="state == 'confirmed' or line_ids"/>
                        </group>
                        <group name="scope">
                            <field name="account_prefix"
                                   readonly="state == 'confirmed'"/>
                            <field name="analytic_plan_id"
                                   invisible="dimension_kind != 'analytic'"
                                   required="dimension_kind == 'analytic'"
                                   readonly="state == 'confirmed'"/>
                            <field name="subconto_type_id"
                                   invisible="dimension_kind != 'subconto'"
                                   required="dimension_kind == 'subconto'"
                                   readonly="state == 'confirmed'"/>
                            <field name="show_all_columns"/>
                            <field name="dimension_kind" invisible="1"/>
                            <field name="use_cost_elements" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Control" invisible="not line_ids">
                        <group>
                            <field name="total_debit"/>
                            <field name="control_debit"/>
                            <field name="unassigned_amount"/>
                        </group>
                        <group>
                            <field name="total_credit"/>
                            <field name="control_credit"/>
                            <field name="is_balanced"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Statement" name="matrix">
                            <widget name="masb_account_turnover_matrix"/>
                        </page>
                        <page string="Lines" name="lines">
                            <field name="line_ids" readonly="1">
                                <list string="Lines"
                                      decoration-bf="line_type == 'group'"
                                      default_order="sequence">
                                    <field name="sequence" column_invisible="1"/>
                                    <field name="line_type"
                                           column_invisible="1"/>
                                    <field name="account_id"/>
                                    <field name="dimension_name"/>
                                    <field name="cost_element"
                                           column_invisible="not parent.use_cost_elements"/>
                                    <field name="opening_debit"/>
                                    <field name="opening_credit"/>
                                    <field name="turnover_debit"
                                           sum="Total debit"/>
                                    <field name="turnover_credit"
                                           sum="Total credit"/>
                                    <field name="closing_debit"/>
                                    <field name="closing_credit"/>
                                    <field name="currency_id"
                                           column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="masb_account_turnover_view_list" model="ir.ui.view">
        <field name="name">masb.account.turnover.list</field>
        <field name="model">masb.account.turnover</field>
        <field name="arch" type="xml">
            <list string="Journal-Orders and Ledgers">
                <field name="name"/>
                <field name="type_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="account_prefix"/>
                <field name="total_debit" sum="Total debit"/>
                <field name="total_credit" sum="Total credit"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'confirmed'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="masb_account_turnover_view_search" model="ir.ui.view">
        <field name="name">masb.account.turnover.search</field>
        <field name="model">masb.account.turnover</field>
        <field name="arch" type="xml">
            <search string="Journal-Orders and Ledgers">
                <field name="name"/>
                <field name="type_id"/>
                <filter name="draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmed"
                        domain="[('state', '=', 'confirmed')]"/>
                <separator/>
                <filter name="date_from" string="Period" date="date_from"/>
                <group>
                    <filter name="group_type" string="Statement Type"
                            context="{'group_by': 'type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="masb_account_turnover_action" model="ir.actions.act_window">
        <field name="name">Journal-Orders and Ledgers</field>
        <field name="res_model">masb.account.turnover</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_type': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Build a journal-order and ledger of an account
            </p>
            <p>
                Pick the statement type, set the period and press Compute.
            </p>
        </field>
    </record>

    <record id="masb_account_turnover_line_view_list" model="ir.ui.view">
        <field name="name">masb.account.turnover.line.list</field>
        <field name="model">masb.account.turnover.line</field>
        <field name="arch" type="xml">
            <list string="Statement Lines" create="false">
                <field name="sheet_id"/>
                <field name="account_id"/>
                <field name="dimension_name"/>
                <field name="cost_element" optional="hide"/>
                <field name="opening_debit"/>
                <field name="opening_credit"/>
                <field name="turnover_debit" sum="Total debit"/>
                <field name="turnover_credit" sum="Total credit"/>
                <field name="closing_debit"/>
                <field name="closing_credit"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

</odoo>
